<%- include('../partials/head', { title: '基金管理', page: 'admin' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><i class="bi bi-building me-2"></i>基金管理</h4>
  <a href="/admin/funds/new" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>新增基金
  </a>
</div>

<% if (saved) { %>
  <div class="alert alert-success alert-dismissible fade show">
    <i class="bi bi-check-circle me-1"></i>已儲存
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <% if (funds.length === 0) { %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-building fs-2 d-block mb-2"></i>
        尚未建立任何基金，請點選「新增基金」
      </div>
    <% } else { %>
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>基金名稱</th>
          <th>成立日期</th>
          <th>成立已滿</th>
          <th>狀態</th>
          <th class="text-end">操作</th>
        </tr>
      </thead>
      <tbody>
        <% for (const f of funds) {
          const inceptionMs = new Date(f.inception_date).getTime();
          const nowMs = Date.now();
          const diffDays = Math.floor((nowMs - inceptionMs) / 86400000);
          const years = Math.floor(diffDays / 365);
          const months = Math.floor((diffDays % 365) / 30);
          const ageLabel = years > 0 ? `${years} 年 ${months} 個月` : `${months} 個月`;
        %>
        <tr class="<%= f.is_active ? '' : 'text-muted' %>">
          <td class="fw-semibold"><%= f.name %></td>
          <td><%= f.inception_date %></td>
          <td>
            <span class="badge <%= years >= 1 ? 'bg-success' : 'bg-warning text-dark' %>">
              <%= ageLabel %>
            </span>
            <% if (years < 1) { %>
              <span class="text-muted small ms-1">（未滿一年，績效揭露受限）</span>
            <% } %>
          </td>
          <td>
            <% if (f.is_active) { %>
              <span class="badge bg-success">啟用</span>
            <% } else { %>
              <span class="badge bg-secondary">停用</span>
            <% } %>
          </td>
          <td class="text-end">
            <a href="/admin/funds/<%= f.id %>/edit" class="btn btn-sm btn-outline-secondary me-1">
              <i class="bi bi-pencil"></i>
            </a>
            <form method="POST" action="/admin/funds/<%= f.id %>/toggle" class="d-inline">
              <button type="submit" class="btn btn-sm <%= f.is_active ? 'btn-outline-warning' : 'btn-outline-success' %> me-1"
                title="<%= f.is_active ? '停用' : '啟用' %>">
                <i class="bi bi-<%= f.is_active ? 'pause' : 'play' %>"></i>
              </button>
            </form>
            <form method="POST" action="/admin/funds/<%= f.id %>/delete" class="d-inline"
              onsubmit="return confirm('確定刪除「<%= f.name %>」？')">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>

<div class="mt-3 text-muted small">
  <i class="bi bi-info-circle me-1"></i>
  成立日期用於判斷績效揭露資格——基金成立未滿一年時，依規定不得揭露績效數據。
  上傳文宣時選擇對應基金，系統即可依成立日自動判斷相關檢查項目是否適用。
</div>

<%- include('../partials/foot') %>
