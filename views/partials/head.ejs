<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>廣告文宣檢查工具</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/app.css">
</head>
<body>
<nav class="navbar navbar-expand-lg">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/upload">
      <i class="bi bi-shield-check me-1"></i>廣告文宣檢查工具
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link <%= typeof page !== 'undefined' && page==='upload' ? 'active' : '' %>" href="/upload">
            <i class="bi bi-upload me-1"></i>上傳文件
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof page !== 'undefined' && page==='history' ? 'active' : '' %>" href="/history">
            <i class="bi bi-clock-history me-1"></i>歷史記錄
          </a>
        </li>
        <% if (user && user.role === 'admin') { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= typeof page !== 'undefined' && page==='admin' ? 'active' : '' %>" href="#" data-bs-toggle="dropdown">
            <i class="bi bi-gear me-1"></i>管理
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/admin/check-items"><i class="bi bi-list-check me-2"></i>檢查項目</a></li>
            <li><a class="dropdown-item" href="/admin/fund-warnings"><i class="bi bi-exclamation-triangle me-2"></i>基金警語</a></li>
            <li><a class="dropdown-item" href="/admin/funds"><i class="bi bi-building me-2"></i>基金管理</a></li>
            <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people me-2"></i>使用者管理</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/admin/settings"><i class="bi bi-sliders me-2"></i>系統設定</a></li>
          </ul>
        </li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle me-1"></i><%= user ? user.username : '' %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <form method="POST" action="/logout">
                <button type="submit" class="dropdown-item text-danger">
                  <i class="bi bi-box-arrow-right me-2"></i>登出
                </button>
              </form>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
<main class="container-fluid py-4">
