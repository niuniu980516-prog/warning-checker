<%- include('../partials/head', { title: '基金警語管理', page: 'admin' }) %>

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
  <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>基金警語管理</h4>
  <a href="/admin/fund-warnings/new" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>新增警語
  </a>
</div>

<% if (saved) { %>
<div class="alert alert-success alert-dismissible fade show py-2">
  <i class="bi bi-check-circle me-2"></i>儲存成功
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>

<div class="card shadow-sm mb-3">
  <div class="card-body py-2">
    <form method="GET" class="row g-2 align-items-center">
      <div class="col">
        <input type="text" name="q" class="form-control" placeholder="搜尋基金名稱或別名…" value="<%= q || '' %>">
      </div>
      <div class="col-auto">
        <button class="btn btn-outline-secondary px-3"><i class="bi bi-search"></i></button>
      </div>
      <% if (q) { %>
      <div class="col-auto">
        <a href="/admin/fund-warnings" class="btn btn-outline-danger">清除</a>
      </div>
      <% } %>
    </form>
  </div>
</div>

<% if (!funds || funds.length === 0) { %>
<div class="card shadow-sm">
  <div class="card-body text-center py-4 text-muted">
    <i class="bi bi-search fs-1 d-block mb-2"></i>
    <%= q ? '找不到符合的警語' : '尚無基金警語資料' %>
  </div>
</div>
<% } else { %>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>基金名稱</th>
          <th style="width:160px">類別</th>
          <th>別名</th>
          <th style="width:60px">狀態</th>
          <th style="width:110px"></th>
        </tr>
      </thead>
      <tbody>
        <% for (const f of funds) { %>
        <%
          let aliases = [];
          try { aliases = JSON.parse(f.aliases || '[]'); } catch {}
        %>
        <tr class="<%= f.is_active ? '' : 'table-secondary opacity-50' %>">
          <td class="fw-semibold"><%= f.fund_name %></td>
          <td class="small text-muted"><%= f.warning_category || '未分類' %></td>
          <td class="small text-muted">
            <% if (aliases.length > 0) { %>
              <%= aliases.slice(0,3).join('、') %><% if(aliases.length>3){%>…<% } %>
            <% } else { %>—<% } %>
          </td>
          <td>
            <span class="badge bg-<%= f.is_active ? 'success' : 'secondary' %>">
              <%= f.is_active ? '啟用' : '停用' %>
            </span>
          </td>
          <td class="text-end">
            <a href="/admin/fund-warnings/<%= f.id %>/edit" class="btn btn-sm btn-outline-secondary me-1">
              <i class="bi bi-pencil"></i>
            </a>
            <form method="POST" action="/admin/fund-warnings/<%= f.id %>/toggle" class="d-inline">
              <button type="submit"
                class="btn btn-sm btn-outline-<%= f.is_active ? 'warning' : 'success' %> me-1"
                title="<%= f.is_active ? '停用' : '啟用' %>">
                <i class="bi bi-toggle-<%= f.is_active ? 'on' : 'off' %>"></i>
              </button>
            </form>
            <form method="POST" action="/admin/fund-warnings/<%= f.id %>/delete" class="d-inline"
              onsubmit="return confirm('確定要刪除？')">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<%- include('../partials/foot') %>
