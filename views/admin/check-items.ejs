<%- include('../partials/head', { title: '檢查項目管理', page: 'admin' }) %>

<div class="d-flex align-items-center justify-content-between mb-3">
  <h4 class="mb-0"><i class="bi bi-list-check me-2"></i>檢查項目管理</h4>
  <a href="/admin/check-items/new" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>新增項目
  </a>
</div>

<% if (saved) { %>
<div class="alert alert-success alert-dismissible fade show py-2">
  <i class="bi bi-check-circle me-2"></i>儲存成功
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th style="width:50px;text-align:center">序號</th>
          <th style="width:120px">類別</th>
          <th>描述</th>
          <th style="width:80px">類型</th>
          <th style="width:60px">狀態</th>
          <th style="width:110px"></th>
        </tr>
      </thead>
      <tbody>
        <% for (const item of items) { %>
        <%
          const checkTypeBadge = (t) => t === 'auto_keyword'
            ? '<span class="badge bg-info text-dark">關鍵字</span>'
            : t === 'auto_format' ? '<span class="badge bg-secondary">格式</span>' : '<span class="badge bg-warning text-dark">AI</span>';
        %>
        <tr class="<%= item.is_active ? '' : 'table-secondary opacity-50' %>">
          <td class="text-center text-muted"><%= item.sort_order %></td>
          <td class="small text-muted"><%= item.category %></td>
          <td>
            <div><%= item.description %></div>
            <% if (item.subItems.length > 1) { %>
            <ul class="list-unstyled mt-2 mb-0 ms-2 border-start ps-2" style="font-size:.8rem">
              <% item.subItems.forEach((sub, idx) => { %>
              <li class="<%= idx > 0 ? 'mt-1' : '' %> <%= sub.is_active ? '' : 'text-muted text-decoration-line-through' %>">
                <span class="text-muted">子項目<%= idx + 1 %>：</span>
                <%= sub.description || '（沿用上方主描述）' %>
                <%- checkTypeBadge(sub.check_type) %>
                <% if (sub.applicability_prompt || sub.compliance_prompt) { %>
                  <span class="badge bg-light text-primary border border-primary-subtle" title="已自訂 AI 適用性／合規判斷提示詞">自訂提示詞</span>
                <% } %>
                <% if (!sub.is_active) { %><span class="badge bg-secondary">停用</span><% } %>
              </li>
              <% }) %>
            </ul>
            <% } else if (item.subItems.length === 1) { %>
              <% const sub = item.subItems[0]; %>
              <% if (sub.applicability_prompt || sub.compliance_prompt) { %>
                <span class="badge bg-light text-primary border border-primary-subtle ms-1" title="已自訂 AI 適用性／合規判斷提示詞">自訂 AI 提示詞</span>
              <% } %>
            <% } %>
          </td>
          <td>
            <% if (item.subItems.length === 1) { %>
              <%- checkTypeBadge(item.subItems[0].check_type) %>
            <% } else { %>
              <span class="badge bg-light text-dark border" title="此序號包含多個子檢查項目，各自有獨立的類型設定"><%= item.subItems.length %> 個子項目</span>
            <% } %>
          </td>
          <td>
            <% if (item.is_active) { %>
              <span class="badge bg-success">啟用</span>
            <% } else { %>
              <span class="badge bg-secondary">停用</span>
            <% } %>
          </td>
          <td class="text-end">
            <a href="/admin/check-items/<%= item.id %>/edit" class="btn btn-sm btn-outline-secondary me-1">
              <i class="bi bi-pencil"></i>
            </a>
            <form method="POST" action="/admin/check-items/<%= item.id %>/toggle" class="d-inline">
              <button type="submit"
                class="btn btn-sm btn-outline-<%= item.is_active ? 'warning' : 'success' %> me-1"
                title="<%= item.is_active ? '停用' : '啟用' %>">
                <i class="bi bi-toggle-<%= item.is_active ? 'on' : 'off' %>"></i>
              </button>
            </form>
            <form method="POST" action="/admin/check-items/<%= item.id %>/delete" class="d-inline"
              onsubmit="return confirm('確定要刪除此項目？（含其所有子項目）')">
              <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>
