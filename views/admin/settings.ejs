<%- include('../partials/head', { title: '系統設定', page: 'admin' }) %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow-sm">
      <div class="card-header bg-primary bg-opacity-10 fw-semibold">
        <i class="bi bi-sliders me-2"></i>系統設定
      </div>
      <div class="card-body p-4">

        <% if (typeof saved !== 'undefined' && saved) { %>
          <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>設定已儲存</div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/settings">
          <div class="mb-2">
            <label class="form-label fw-semibold">AI 系統提示詞（SYSTEM PROMPT）</label>
            <p class="text-muted small mb-2">
              這段文字會放在每一次 AI 審查提示的開頭，用來定義 AI 的角色與審查立場（例如「你是台灣基金廣告合規審查員」）。
              調整這裡會影響所有 AI 判斷（檢查項目審查、適用性／合規性判斷、圖片視覺檢查）的語氣與審查角度，請謹慎修改。
            </p>
            <textarea name="system_prompt" class="form-control" rows="4"
              placeholder="例如：你是台灣基金廣告合規審查員" required><%= systemPrompt %></textarea>
          </div>

          <div class="mb-4">
            <span class="text-muted small">預設值：「<%= defaultSystemPrompt %>」</span>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-check-lg me-1"></i>儲存
            </button>
            <button type="button" class="btn btn-outline-secondary"
              onclick="document.querySelector('textarea[name=system_prompt]').value = <%- JSON.stringify(defaultSystemPrompt) %>;">
              <i class="bi bi-arrow-counterclockwise me-1"></i>還原為預設值
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
